{
  "name": "tripflow",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-09",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "secrets": {
    "required": ["GOOGLE_MAPS_API_KEY"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tripflow-production",
      "database_id": "67363457-eabf-4a0f-8803-0de4cfbd9043",
      "migrations_dir": "migrations"
    }
  ]
}
