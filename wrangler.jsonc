{
  "name": "tripflow",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-09",
  "vars": {
    "ALLOWED_ORIGIN": "https://tripflow.carterwu1120.workers.dev",
    "ACCESS_TEAM_DOMAIN": "square-meadow-06ee.cloudflareaccess.com",
    "ACCESS_AUD": "aabd416604df16b1150cbfcaae6b2dbfc5c079331429bb0fd642999b18b0818d"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "secrets": {
    "required": ["GOOGLE_MAPS_API_KEY"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tripflow-production",
      "database_id": "67363457-eabf-4a0f-8803-0de4cfbd9043",
      "migrations_dir": "migrations"
    }
  ]
}
